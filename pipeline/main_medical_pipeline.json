													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": "@concat('SELECT * FROM [', item().SourceSchema, '].[', item().SourceTable, '] ',\r\n'WHERE ', item().WatermarkColumn, ' > ''',\r\n   formatDateTime(coalesce(item().LastRunTime,'1900-01-01'),'yyyy-MM-dd HH:mm:ss'), ''' ',\r\n'AND ', item().WatermarkColumn, ' <= ''',\r\n   formatDateTime(convertTimeZone(pipeline().TriggerTime,'UTC','India Standard Time'),'yyyy-MM-dd HH:mm:ss'), '''')",
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
